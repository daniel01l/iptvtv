<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="#FF2F80ED"/><corners android:radius="6dp"/></shape>
    </item>
    <item android:state_activated="true">
        <shape><solid android:color="#FF26324A"/><corners android:radius="6dp"/></shape>
    </item>
    <item>
        <shape><solid android:color="#00000000"/><corners android:radius="6dp"/>
            <stroke android:width="1dp" android:color="#22FFFFFF"/></shape>
    </item>
</selector>
