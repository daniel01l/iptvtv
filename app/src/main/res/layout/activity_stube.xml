<?xml version="1.0" encoding="utf-8"?>
<!-- STube: pionowy pasek ikon po lewej (na wąskim ekranie – poziomy u góry), po prawej wyszukiwarka, pigułki biblioteki i poziome rzędy
     (pilot: ▲▼ między rzędami, ◄► w rzędzie, ◄ na początku rzędu – pasek ikon). Kolory i kształty z motywu ([Ui]), treść przycięta do ekranu. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/stRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:clipChildren="true">
    <LinearLayout android:id="@+id/stRail" android:layout_width="wrap_content" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center_horizontal" android:clipChildren="false"
        android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="16dp" android:paddingBottom="16dp">
        <TextView android:id="@+id/stAccount" style="@style/StubeRail" android:text="👤"/>
        <TextView android:id="@+id/stSearch" style="@style/StubeRail" android:layout_marginTop="14dp" android:text="🔎"/>
        <TextView android:id="@+id/stHome" style="@style/StubeRail" android:text="🏠"/>
        <TextView android:id="@+id/stLib" style="@style/StubeRail" android:text="🎵"/>
        <TextView android:id="@+id/stPhone" style="@style/StubeRail" android:text="📱"/>
        <TextView android:id="@+id/stSmartTube" style="@style/StubeRail" android:text="▶"/>
        <View android:id="@+id/stRailSpace" android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>
        <TextView android:id="@+id/stRefresh" style="@style/StubeRail" android:text="⟳"/>
        <TextView android:id="@+id/stClose" style="@style/StubeRail" android:text="✕"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/stMain" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
        android:orientation="vertical" android:clipChildren="true"
        android:paddingStart="16dp" android:paddingEnd="32dp" android:paddingTop="16dp" android:paddingBottom="0dp">
        <LinearLayout android:id="@+id/stSearchRow" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/stTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginEnd="16dp" android:text="STube" android:textSize="24sp" android:textStyle="bold" android:tag="accent"/>
            <!-- podpowiedzi z historii wyszukiwania (StubeHistory, Room) – lista pod polem, ▼ w liście, OK = szukaj -->
            <AutoCompleteTextView android:id="@+id/stQuery" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:tag="field" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="10dp" android:paddingBottom="10dp"
                android:textSize="17sp" android:singleLine="true" android:inputType="text" android:imeOptions="actionSearch"
                android:hint="Szukaj w STube…" android:completionThreshold="1000" android:dropDownWidth="match_parent"/>
        </LinearLayout>
        <HorizontalScrollView android:id="@+id/stChipScroll" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:scrollbars="none" android:focusable="false" android:clipChildren="true" android:clipToPadding="false"
            android:visibility="gone">
            <LinearLayout android:id="@+id/stChips" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:paddingTop="2dp" android:paddingBottom="2dp" android:paddingEnd="24dp"/>
        </HorizontalScrollView>
        <TextView android:id="@+id/stInfo" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:tag="text2" android:textSize="14sp" android:visibility="gone"/>
        <ScrollView android:id="@+id/stScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:layout_marginTop="4dp" android:focusable="false" android:fillViewport="true" android:scrollbars="none" android:clipChildren="true">
            <LinearLayout android:id="@+id/stRows" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingBottom="120dp"/>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
