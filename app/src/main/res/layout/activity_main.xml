<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="20dp">

    <LinearLayout android:id="@+id/topBar" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/expiry" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginEnd="12dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="4dp"
            android:paddingBottom="4dp" android:textStyle="bold" android:textSize="14sp" android:tag="keepcolor" android:visibility="gone"/>
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="@string/app_name" android:textSize="22sp" android:textStyle="bold" android:tag="accent"/>
        <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginEnd="12dp" android:tag="text2"/>
        <TextView android:id="@+id/weather" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="17sp" android:layout_marginEnd="14dp" android:visibility="gone"/>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical"
            android:gravity="end">
            <TextView android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="22sp" android:textStyle="bold"/>
            <TextView android:id="@+id/date" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="12sp" android:tag="text2"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/searchRow" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:orientation="horizontal" android:visibility="gone"
        android:gravity="center_vertical">
        <EditText android:id="@+id/searchField" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:tag="field" android:padding="10dp" android:singleLine="true"
            android:inputType="text" android:imeOptions="actionSearch" android:hint="Nazwa kanału, numer lub tytuł programu"/>
        <TextView android:id="@+id/searchClose" style="@style/TopBtn" android:text="✕ Zamknij"/>
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="12dp">
        <LinearLayout android:id="@+id/content" android:layout_width="match_parent"
            android:layout_height="match_parent" android:orientation="horizontal">
            <LinearLayout android:id="@+id/sideNav" android:layout_width="wrap_content" android:layout_height="match_parent"
                android:orientation="vertical" android:layout_marginEnd="10dp" android:tag="panel" android:padding="6dp">
                <TextView android:id="@+id/btnEpgSearch" style="@style/SideBtn" android:text="Program"/>
                <TextView android:id="@+id/btnSearch" style="@style/SideBtn" android:text="Kanały"/>
                <TextView android:id="@+id/btnSTube" style="@style/SideBtn" android:text="STube"/>
                <TextView android:id="@+id/btnEditor" style="@style/SideBtn" android:text="Edytor"/>
                <TextView android:id="@+id/btnSettings" style="@style/SideBtn" android:text="Ustawienia"/>
                <TextView android:id="@+id/btnApps" style="@style/SideBtn" android:text="Aplikacje" android:visibility="gone"/>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/groups" android:tag="panel"
                android:layout_width="64dp" android:layout_height="match_parent" android:padding="6dp"
                android:clipToPadding="false"/>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/channels" android:tag="panel"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                android:layout_marginStart="10dp" android:padding="6dp" android:clipToPadding="false"/>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1.25" android:layout_height="match_parent"
                android:layout_marginStart="10dp" android:tag="panel" android:orientation="vertical" android:padding="10dp" android:id="@+id/infoPanel">
                <FrameLayout android:id="@+id/previewBox" android:layout_width="match_parent" android:layout_height="190dp"
                    android:background="#000000">
                    <androidx.media3.ui.PlayerView xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/preview" android:layout_width="match_parent"
                        android:layout_height="match_parent" android:focusable="false" app:use_controller="false" app:show_buffering="never"/>
                    <TextView android:id="@+id/previewHint" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_gravity="center" android:textColor="#AAFFFFFF" android:text="Podgląd kanału" android:tag="keepcolor"/>
                </FrameLayout>
                <TextView android:id="@+id/epgChannel" android:layout_width="match_parent" android:layout_marginTop="6dp"
                    android:layout_height="wrap_content" android:textSize="20sp" android:textStyle="bold" android:gravity="center"
                    android:singleLine="true" android:ellipsize="end"/>
                <TextView android:id="@+id/epgDesc" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:maxLines="2" android:ellipsize="end" android:layout_marginTop="2dp" android:textSize="13sp" android:tag="text2" android:gravity="center"/>
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/programmes"
                    android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/empty" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:gravity="center_horizontal" android:orientation="vertical" android:visibility="gone">
            <TextView android:id="@+id/emptyAdd" android:layout_width="120dp" android:layout_height="120dp" android:gravity="center"
                android:text="+" android:textSize="64sp" android:textStyle="bold" android:tag="item accent" android:focusable="true"
                android:clickable="true" android:contentDescription="Dodaj listę kanałów"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp"
                android:gravity="center" android:textSize="18sp" android:text="Brak listy kanałów.\nKliknij +, aby dodać listę w Ustawieniach."/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
