<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="60dp" android:tag="item"
    android:focusable="true" android:clickable="true" android:gravity="center_vertical"
    android:layout_marginBottom="4dp" android:orientation="horizontal" android:paddingStart="8dp">
    <TextView android:id="@+id/num" android:layout_width="44dp" android:layout_height="wrap_content"
        android:gravity="end" android:layout_marginEnd="8dp" android:tag="text2"/>
    <ImageView android:id="@+id/picon" android:layout_width="64dp" android:layout_height="40dp" android:scaleType="fitCenter"/>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:layout_marginStart="10dp" android:orientation="vertical">
        <TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:singleLine="true" android:ellipsize="end" android:textSize="16sp" android:textStyle="bold"/>
        <TextView android:id="@+id/sub" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:singleLine="true" android:ellipsize="end" android:textSize="12sp" android:tag="text2"/>
    </LinearLayout>
    <TextView android:id="@+id/flags" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="16sp" android:layout_marginStart="6dp"/>
    <TextView android:id="@+id/handle" android:layout_width="56dp" android:layout_height="match_parent"
        android:gravity="center" android:text="≡" android:textSize="26sp" android:tag="text2"/>
</LinearLayout>
