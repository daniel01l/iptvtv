<?xml version="1.0" encoding="utf-8"?>
<!-- Nowoczesny: zamykany ekran gaśnie i lekko się oddala (1 → 1.03) – ekran pod spodem stoi nieruchomo -->
<set xmlns:android="http://schemas.android.com/apk/res/android" android:duration="200"
    android:interpolator="@android:interpolator/accelerate_cubic" android:shareInterpolator="true">
    <alpha android:fromAlpha="1" android:toAlpha="0"/>
    <scale android:fromXScale="1" android:toXScale="1.03" android:fromYScale="1" android:toYScale="1.03"
        android:pivotX="50%" android:pivotY="50%"/>
</set>
